{
  "name": "@azizuysal/wallet-kit",
  "version": "2.0.0",
  "description": "A React Native wrapper for Apple and Google wallet passes",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/app/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @azizuysal/wallet-kit-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:markdown": "typedoc --plugin typedoc-plugin-markdown --out docs/api-markdown",
    "generate-jwt": "node scripts/generate-jwt.js",
    "validate:resources": "node scripts/validate-android-resources.mjs",
    "validate:secrets": "node scripts/scan-secrets.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "validate:compatibility": "node scripts/validate-compatibility.mjs",
    "compatibility:matrix": "node scripts/compatibility-matrix.mjs",
    "codegen": "react-native codegen",
    "verify": "yarn validate:compatibility && yarn validate:resources && yarn validate:secrets && yarn lint && yarn typecheck && yarn test --coverage && yarn prepare && yarn docs && yarn codegen && yarn validate:package"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "wallet",
    "apple-wallet",
    "google-wallet",
    "passkit",
    "pkpass",
    "passes",
    "mobile-wallet",
    "digital-wallet",
    "wallet-pass",
    "react-native-wallet",
    "add-to-wallet",
    "payment",
    "tickets",
    "boarding-pass",
    "loyalty-card"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azizuysal/wallet-kit.git"
  },
  "author": "Aziz Uysal (https://github.com/azizuysal)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/azizuysal/wallet-kit/issues"
  },
  "homepage": "https://github.com/azizuysal/wallet-kit#readme",
  "security": {
    "email": "security@azizuysal.com",
    "url": "https://github.com/azizuysal/wallet-kit/blob/main/SECURITY.md"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "commitlint": "^20.5.0",
    "conventional-changelog-cli": "^5.0.0",
    "del-cli": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^17.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "react": "19.2.5",
    "react-native": "0.86.2",
    "react-native-builder-bob": "0.43.0",
    "react-native-test-app": "5.4.6",
    "react-test-renderer": "19.2.5",
    "typedoc": "^0.28.11",
    "typedoc-plugin-markdown": "^4.8.1",
    "typescript": "^5.9.3",
    "yargs": "17"
  },
  "resolutions": {
    "@types/react": "^19.2.14",
    "brace-expansion@npm:^1.1.7": "npm:1.1.18",
    "brace-expansion@npm:^2.0.1": "npm:2.1.4",
    "brace-expansion@npm:^5.0.5": "npm:5.0.9",
    "eslint-plugin-ft-flow": "^3.0.11",
    "fast-uri@npm:^3.0.1": "npm:3.1.4",
    "flatted@npm:^3.2.9": "npm:3.4.4",
    "glob@npm:^10.2.2": "npm:10.5.0",
    "glob@npm:^10.3.10": "npm:10.5.0",
    "glob@npm:^10.3.7": "npm:10.5.0",
    "handlebars@npm:^4.7.7": "npm:4.7.9",
    "image-size@npm:^1.0.2": "npm:1.2.1",
    "js-yaml@npm:^3.13.1": "npm:3.15.0",
    "linkify-it@npm:^5.0.0": "npm:5.0.2",
    "lodash@npm:^4.17.21": "npm:4.18.1",
    "minimatch@npm:^9.0.4": "npm:9.0.9",
    "minimatch@npm:^9.0.5": "npm:9.0.9",
    "picomatch@npm:^2.0.4": "npm:2.3.2",
    "picomatch@npm:^2.2.3": "npm:2.3.2",
    "picomatch@npm:^2.3.1": "npm:2.3.2",
    "tar@npm:^7.4.3": "npm:7.5.22",
    "ws@npm:^7": "npm:7.5.13",
    "ws@npm:^7.5.10": "npm:7.5.13"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.76.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.0",
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/",
      "\\.d\\.ts$"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation)/)"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/node_modules/react-native"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/*.spec.{ts,tsx}",
      "!src/WalletButton.types.ts",
      "!src/specs/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 90,
        "lines": 90,
        "statements": 90
      },
      "./src/WalletButton.ios.tsx": {
        "branches": 95,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/WalletButton.android.tsx": {
        "branches": 95,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/index.tsx": {
        "branches": 85,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNWalletKitSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.azizuysal.walletkit"
    },
    "ios": {
      "modulesProvider": {
        "WalletKit": "WalletKit"
      },
      "componentProvider": {
        "WalletButton": "WalletButtonComponentView"
      }
    }
  }
}
